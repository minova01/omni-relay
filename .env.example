APP_ENV=local
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT_MS=10000
HTTP_WRITE_TIMEOUT_MS=30000
HTTP_SHUTDOWN_TIMEOUT_MS=10000

POSTGRES_DSN=postgres://omni_relay:replace-me@127.0.0.1:5432/omni_relay?sslmode=disable
POSTGRES_MAX_CONNS=20

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=omni-relay
KAFKA_BILLING_TOPIC=omni-relay.billing.settled.v1
KAFKA_CONSUMER_GROUP=omni-relay-consumption-v1
KAFKA_BATCH_SIZE=500
KAFKA_TLS_ENABLED=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

SESSION_TTL_MS=86400000
SESSION_COOKIE_SECURE=false

# Base64-encoded 32-byte key. Generate a unique value before starting the service.
SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

UPSTREAM_TIMEOUT_MS=120000
UPSTREAM_MAX_BODY_BYTES=10485760

